<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>E-Commerce UI</title>

<style>
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
    font-family:Arial,sans-serif;
}

body{
    background:#f5f5f5;
}

header{
    background:#1e3a8a;
    color:white;
    padding:15px 30px;
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
}

header input{
    padding:10px;
    width:250px;
    border:none;
    border-radius:5px;
}

.cart{
    font-size:20px;
}

.container{
    width:90%;
    margin:30px auto;
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
    gap:20px;
}

.card{
    background:white;
    border-radius:10px;
    overflow:hidden;
    box-shadow:0 5px 15px rgba(0,0,0,.1);
    transition:.3s;
}

.card:hover{
    transform:translateY(-5px);
}

.card img{
    width:100%;
    height:200px;
    object-fit:cover;
}

.info{
    padding:15px;
}

.info h3{
    margin-bottom:10px;
}

.price{
    color:green;
    font-size:20px;
    margin-bottom:10px;
}

button{
    width:100%;
    padding:10px;
    border:none;
    border-radius:5px;
    cursor:pointer;
    margin-top:8px;
}

.cartBtn{
    background:#2563eb;
    color:white;
}

.likeBtn{
    background:#ef4444;
    color:white;
}
</style>
</head>
<body>

<header>
<h2>🛒 My Store</h2>

<input type="text" placeholder="Search Products">

<div class="cart">
🛒 Cart:
<span id="count">0</span>
</div>
</header>

<div class="container">

<div class="card">
<img src="https://picsum.photos/300/200?1">
<div class="info">
<h3>Wireless Headphone</h3>
<p class="price">$99</p>
<button class="cartBtn" onclick="addCart()">Add to Cart</button>
<button class="likeBtn">❤ Wishlist</button>
</div>
</div>

<div class="card">
<img src="https://picsum.photos/300/200?2">
<div class="info">
<h3>Smart Watch</h3>
<p class="price">$149</p>
<button class="cartBtn" onclick="addCart()">Add to Cart</button>
<button class="likeBtn">❤ Wishlist</button>
</div>
</div>

<div class="card">
<img src="https://picsum.photos/300/200?3">
<div class="info">
<h3>Gaming Mouse</h3>
<p class="price">$45</p>
<button class="cartBtn" onclick="addCart()">Add to Cart</button>
<button class="likeBtn">❤ Wishlist</button>
</div>
</div>

<div class="card">
<img src="https://picsum.photos/300/200?4">
<div class="info">
<h3>Bluetooth Speaker</h3>
<p class="price">$79</p>
<button class="cartBtn" onclick="addCart()">Add to Cart</button>
<button class="likeBtn">❤ Wishlist</button>
</div>
</div>

</div>

<script>
let cart = 0;

function addCart(){
    cart++;
    document.getElementById("count").innerHTML = cart;
}
</script>

</body>
</html>
